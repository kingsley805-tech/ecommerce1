# =============================================================================
# MODERN COMMERCE — ENVIRONMENT VARIABLES
# Copy to .env and fill in real values. Never commit real credentials.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
APP_BASE_URL=http://localhost:4000
TZ=UTC

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modern_commerce?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=modern_commerce
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth / Security ---
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access-secret-64-hex-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-64-hex-chars
JWT_COOKIE_SECRET=change-me-cookie-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
CSRF_COOKIE_NAME=csrf_token

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=modern-commerce
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/modern-commerce
S3_FORCE_PATH_STYLE=true

# --- Email (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM="Modern Commerce <no-reply@example.com>"
SMTP_SECURE=false

# --- Payments ---
# Only configure gateways you have merchant credentials for.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=ghs
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Mobile money (Ghana) via Paystack/Flutterwave or a MoMo provider:
PAYMENT_METHODS=card,mobile_money,bank_transfer,cash_on_delivery
DEFAULT_CURRENCY=GHS
DEFAULT_CURRENCY_SYMBOL=₵

# --- Admin bootstrap (first super admin created by seed) ---
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@12345

# --- Seeds (dev only) ---
SEED_DEV_DATA=true

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=

# --- Maintenance / Features ---
MAINTENANCE_MODE=false
