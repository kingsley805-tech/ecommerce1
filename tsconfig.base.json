{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@commerce/shared-types": ["packages/shared-types/src/index.ts"],
      "@commerce/validation": ["packages/validation/src/index.ts"],
      "@commerce/shared-config": ["packages/shared-config/src/index.ts"]
    }
  }
}
