// Modern Commerce — Prisma schema
// PostgreSQL database. All monetary values use numeric(12,2). Timestamps UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  STORE_MANAGER
  PRODUCT_MANAGER
  INVENTORY_MANAGER
  FULFILLMENT_STAFF
  CUSTOMER_SUPPORT
  MARKETING_MANAGER
  FINANCE_STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_VERIFICATION
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Visibility {
  VISIBLE
  HIDDEN
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  PAYSTACK
  FLUTTERWAVE
  MOBILE_MONEY
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentEventStatus {
  INITIATED
  SUCCEEDED
  FAILED
  FRAUD_REVIEW
  REFUND_REQUESTED
  REFUND_SUCCEEDED
  REFUND_FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTED
  COMPLETED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  SALE
  RETURN_TO_STOCK
  DAMAGED
  WRITTEN_OFF
  COUNT_ADJUSTMENT
}

enum ReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  EXPIRED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromotionAppliesTo {
  ALL
  PRODUCTS
  CATEGORIES
  CUSTOMER_GROUPS
  FIRST_ORDER
}

enum ShippingMethodType {
  FLAT_RATE
  FREE_SHIPPING
  WEIGHT_BASED
  PRICE_BASED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
}

enum OrderAddressType {
  SHIPPING
  BILLING
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum RefundReason {
  RETURN_REQUESTED
  OVERPAYMENT
  DUPLICATE
  OTHER
}

// ---------------------------------------------------------------------------
// Identity, auth, RBAC
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(254)
  passwordHash  String
  firstName     String    @db.VarChar(120)
  lastName      String    @db.VarChar(120)
  phone         String?   @db.VarChar(30)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  addresses      Address[]
  roles          UserRole[]
  customerProfile CustomerProfile?
  carts          Cart[]
  orders         Order[]
  reviews        Review[]
  wishlist      Wishlist?
  notifications  Notification[]
  auditLogs     AuditLog[]     @relation("ActorAuditLogs")
  inventoryMovements InventoryMovement[]

  @@index([status])
  @@index([createdAt])
}

model RoleName {
  id    String @id @default(uuid()) @db.Uuid
  key   Role   @unique
  name  String @db.VarChar(120)
  description String?
  permissions RolePermission[]
  userRoles UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(120)
  name        String @db.VarChar(120)
  description String?
  group       String @db.VarChar(60)
  roles       RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  role RoleName @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RoleName @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model CustomerProfile {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @unique @db.Uuid
  consentNewsletter Boolean @default(false)
  emailVerifiedAt DateTime?
  note     String?
  groups   CustomerGroupMember[]
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerGroup {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(120)
  code  String @unique @db.VarChar(60)
  description String?
  discountPercent Decimal? @db.Decimal(5, 2)
  members CustomerGroupMember[]

  @@map("customer_groups")
}

model CustomerGroupMember {
  customerProfileId String @db.Uuid
  groupId String @db.Uuid
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  group CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([customerProfileId, groupId])
}

model Address {
  id          String @id @default(uuid()) @db.Uuid
  userId      String? @db.Uuid
  label       String? @db.VarChar(60)
  recipientName String @db.VarChar(120)
  phone       String? @db.VarChar(30)
  line1       String @db.VarChar(200)
  line2       String? @db.VarChar(200)
  city        String @db.VarChar(100)
  region      String? @db.VarChar(100)
  postalCode  String? @db.VarChar(20)
  country     String @db.Char(2)
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique @db.VarChar(200)
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenId String? @db.Uuid
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Brand {
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(120)
  slug     String @unique @db.VarChar(160)
  description String? @db.Text
  logoUrl  String?
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}

model Category {
  id          String @id @default(uuid()) @db.Uuid
  parentId    String? @db.Uuid
  name        String @db.VarChar(120)
  slug        String @unique @db.VarChar(160)
  description String? @db.Text
  imageUrl    String?
  displayOrder Int @default(0)
  visibility  Visibility @default(VISIBLE)
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    ProductCategory[]

  @@index([parentId])
  @@index([displayOrder])
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  slug String @unique @db.VarChar(160)
  products ProductTag[]
}

model Product {
  id             String @id @default(uuid()) @db.Uuid
  type           ProductType @default(SIMPLE)
  name           String @db.VarChar(200)
  slug           String @unique @db.VarChar(220)
  sku            String @unique @db.VarChar(60)
  barcode        String? @db.VarChar(60)
  description    String? @db.Text
  shortDescription String? @db.VarChar(500)
  price          Decimal @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  salePrice      Decimal? @db.Decimal(12, 2)
  saleStartAt    DateTime?
  saleEndAt      DateTime?
  status         ProductStatus @default(DRAFT)
  visibility     Visibility @default(VISIBLE)
  featured       Boolean @default(false)
  weightGrams    Int?
  ratingAvg      Decimal @default(0) @db.Decimal(3, 2)
  ratingCount    Int @default(0)
  soldCount      Int @default(0)
  viewCount      Int @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publishedAt    DateTime?
  brandId        String? @db.Uuid
  brand          Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images          ProductImage[]
  variants        ProductVariant[]
  categories      ProductCategory[]
  tags            ProductTag[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  attributes      ProductAttribute[]
  inventoryLevels InventoryLevel[]
  inventoryMovements InventoryMovement[]
  stockReservations StockReservation[]

  @@index([status, visibility])
  @@index([featured])
  @@index([createdAt])
  @@index([ratingAvg])
  @@index([soldCount])
}

model ProductImage {
  id      String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  url     String
  alt     String?
  position Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductVariant {
  id              String @id @default(uuid()) @db.Uuid
  productId       String @db.Uuid
  sku             String @unique @db.VarChar(60)
  barcode         String? @db.VarChar(60)
  name            String? @db.VarChar(120)
  attributes      Json @default("{}")
  price           Decimal @db.Decimal(12, 2)
  compareAtPrice  Decimal? @db.Decimal(12, 2)
  costPrice       Decimal? @db.Decimal(12, 2)
  imageUrl        String?
  isDefault       Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  inventoryMovements InventoryMovement[]
  stockReservations StockReservation[]

  @@index([productId])
  @@map("product_variants")
}

model ProductAttribute {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  name      String @db.VarChar(120)
  values    Json @default("[]")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("product_attributes")
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid
  position   Int @default(0)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductTag {
  productId String @db.Uuid
  tagId     String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// ---------------------------------------------------------------------------
// Cart / Wishlist
// ---------------------------------------------------------------------------

model Cart {
  id        String @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  sessionId String? @db.VarChar(120)
  status    CartStatus @default(ACTIVE)
  couponCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId, status])
  @@index([sessionId])
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  productId String @db.Uuid
  variantId String? @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
}

model Wishlist {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  items  WishlistItem[]
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id         String @id @default(uuid()) @db.Uuid
  wishlistId String @db.Uuid
  productId  String @db.Uuid
  variantId  String? @db.Uuid
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @db.VarChar(40)
  customerId  String? @db.Uuid
  guestEmail  String? @db.VarChar(254)
  customerName String? @db.VarChar(200)
  status      OrderStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  shippingTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)
  currency      String @default("GHS") @db.Char(3)
  couponCode    String?
  promotionSnapshot Json?
  paymentMethod PaymentMethod?
  orderNote     String?
  idempotencyKey String? @unique @db.VarChar(100)
  placedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer User? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  addresses OrderAddress[]
  payments Payment[]
  refunds  Refund[]
  shipments Shipment[]
  returns  Return[]
  reservations StockReservation[]
  redemptions PromotionRedemption[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  productId String? @db.Uuid
  variantId String? @db.Uuid

  sku         String @db.VarChar(60)
  productName String @db.VarChar(200)
  variantLabel String?
  imageUrl    String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  weightGrams Int?
  costPrice   Decimal? @db.Decimal(12, 2)
  refundedQty Int @default(0)

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shipmentItems ShipmentItem[]
  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  type      OrderAddressType
  recipientName String
  phone     String?
  email     String?
  line1     String
  line2     String?
  city      String
  region    String?
  postalCode String?
  country   String @db.Char(2)
  deliveryInstructions String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("order_addresses")
}

// ---------------------------------------------------------------------------
// Payments, refunds
// ---------------------------------------------------------------------------

model Payment {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  reference String @unique @db.VarChar(120)
  provider  PaymentProvider
  method    PaymentMethod
  amount    Decimal @db.Decimal(12, 2)
  currency  String @db.Char(3)
  status    PaymentStatus @default(PENDING)
  gatewayTransactionId String?
  gatewayResponse Json?
  failureReason String?
  webhookVerifiedAt DateTime?
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([provider, status])
  @@index([createdAt])
}

model PaymentEvent {
  id             String @id @default(uuid()) @db.Uuid
  paymentId      String @db.Uuid
  status         PaymentEventStatus
  providerEventId String? @unique
  payload        Json?
  rawHeaders     Json?
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  paymentId String? @db.Uuid
  amount  Decimal @db.Decimal(12, 2)
  currency String @db.Char(3)
  reason  RefundReason
  reasonText String?
  status  RefundStatus @default(REQUESTED)
  gatewayRefundId String?
  restock Boolean @default(false)
  requestedBy String? @db.Uuid
  processedBy String? @db.Uuid
  createdAt DateTime @default(now())
  completedAt DateTime?

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  returns Return[]

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Fulfillment
// ---------------------------------------------------------------------------

model Shipment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  carrier String @db.VarChar(120)
  trackingNumber String @db.VarChar(120)
  trackingUrl String?
  status  ShipmentStatus @default(PENDING)
  shippedAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ShipmentItem[]

  @@index([orderId])
}

model ShipmentItem {
  id         String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid
  orderItemId String @db.Uuid
  quantity   Int
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@map("shipment_items")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Promotion {
  id        String @id @default(uuid()) @db.Uuid
  name      String @db.VarChar(120)
  code      String? @unique @db.VarChar(60)
  type      PromotionType
  value     Decimal? @db.Decimal(12, 2)
  appliesTo PromotionAppliesTo @default(ALL)
  startsAt  DateTime
  endsAt    DateTime?
  isActive  Boolean @default(true)
  minimumOrderAmount Decimal? @db.Decimal(12, 2)
  minimumQuantity Int?
  maxRedemptions Int?
  perCustomerLimit Int?
  stackable Boolean @default(false)
  freeShipping Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productIds String[] @db.Uuid
  categoryIds String[] @db.Uuid
  excludedProductIds String[] @db.Uuid
  customerGroupIds String[] @db.Uuid
  redemptions PromotionRedemption[]

  @@index([code])
}

model PromotionRedemption {
  id        String @id @default(uuid()) @db.Uuid
  promotionId String @db.Uuid
  orderId   String @db.Uuid
  customerId String? @db.Uuid
  amountDiscounted Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([customerId])
  @@map("promotion_redemptions")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model InventoryLocation {
  id    String @id @default(uuid()) @db.Uuid
  name  String @db.VarChar(120)
  code  String @unique @db.VarChar(60)
  isDefault Boolean @default(false)
  levels InventoryLevel[]
  movements InventoryMovement[]

  @@map("inventory_locations")
}

model InventoryLevel {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @db.Uuid
  variantId   String? @db.Uuid
  locationId  String @db.Uuid
  physicalStock Int @default(0)
  reservedStock Int @default(0)
  lowStockThreshold Int?
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, locationId])
  @@index([locationId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id            String @id @default(uuid()) @db.Uuid
  productId     String @db.Uuid
  variantId     String? @db.Uuid
  locationId    String? @db.Uuid
  type          InventoryMovementType
  previousQuantity Int
  quantityChange Int
  resultingQuantity Int
  reason        String?
  reference     String?
  userId        String? @db.Uuid
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  location InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, variantId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model StockReservation {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  productId String @db.Uuid
  variantId String? @db.Uuid
  locationId String? @db.Uuid
  quantity  Int
  status    ReservationStatus @default(RESERVED)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  releasedAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([expiresAt])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Purchasing (suppliers / purchase orders)
// ---------------------------------------------------------------------------

model Supplier {
  id    String @id @default(uuid()) @db.Uuid
  name  String @db.VarChar(200)
  contactName String?
  email String? @db.VarChar(254)
  phone String? @db.VarChar(30)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id     String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid
  number String @unique @db.VarChar(40)
  status PurchaseOrderStatus @default(DRAFT)
  expectedAt DateTime?
  receivedAt DateTime?
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal Decimal @default(0) @db.Decimal(12, 2)
  total Decimal @default(0) @db.Decimal(12, 2)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items PurchaseOrderItem[]

  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  productId String @db.Uuid
  variantId String? @db.Uuid
  quantity Int
  unitCost Decimal @db.Decimal(12, 2)
  receivedQuantity Int @default(0)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Returns
// ---------------------------------------------------------------------------

model Return {
  id       String @id @default(uuid()) @db.Uuid
  orderId  String @db.Uuid
  number   String @unique @db.VarChar(40)
  status   ReturnStatus @default(REQUESTED)
  reason   String @db.VarChar(500)
  customerNote String?
  adminNote String?
  refundId String? @db.Uuid
  requestedBy String? @db.Uuid
  reviewedBy String? @db.Uuid
  receivedAt DateTime?
  inspectedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnItem[]
  refund Refund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ReturnItem {
  id         String @id @default(uuid()) @db.Uuid
  returnId   String @db.Uuid
  orderItemId String @db.Uuid
  quantity   Int
  restocked  Boolean @default(false)
  disposition String?
  returnModel Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnId, orderItemId])
  @@map("return_items")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  customerId String @db.Uuid
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  verifiedPurchase Boolean @default(false)
  helpfulCount Int @default(0)
  moderationNote String?
  moderatedBy String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reports ReviewReport[]

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([customerId])
}

model ReviewReport {
  id       String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  reporterCustomerId String @db.Uuid
  reason   String
  status   ReviewStatus @default(PENDING)
  createdAt DateTime @default(now())
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_reports")
}

// ---------------------------------------------------------------------------
// Notifications / Newsletters
// ---------------------------------------------------------------------------

model Notification {
  id       String @id @default(uuid()) @db.Uuid
  userId   String? @db.Uuid
  channel  NotificationChannel
  type     String @db.VarChar(60)
  subject  String?
  body     String? @db.Text
  data     Json?
  readAt   DateTime?
  sentAt   DateTime?
  error    String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model NewsletterSubscription {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(254)
  subscribed    Boolean @default(true)
  source       String?
  consentAt    DateTime @default(now())
  unsubscribedAt DateTime?
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Content / storefront
// ---------------------------------------------------------------------------

model ContentPage {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique @db.VarChar(160)
  title       String @db.VarChar(200)
  body        String @db.Text
  visibility  Visibility @default(VISIBLE)
  seoTitle    String?
  seoDescription String?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visibility])
  @@map("content_pages")
}

model HomepageSection {
  id        String @id @default(uuid()) @db.Uuid
  type      String @db.VarChar(60)
  title     String?
  subtitle  String?
  config    Json?
  displayOrder Int @default(0)
  isActive  Boolean @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  productIds String[] @db.Uuid
  categoryIds String[] @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@map("homepage_sections")
}

model Testimonial {
  id      String @id @default(uuid()) @db.Uuid
  author  String @db.VarChar(120)
  role    String?
  content String @db.Text
  rating  Int @default(5)
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
}

model NavigationMenu {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  location String @db.VarChar(60)
  items Json
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("navigation_menus")
}

// ---------------------------------------------------------------------------
// Settings, taxes, shipping
// ---------------------------------------------------------------------------

model StoreSetting {
  key       String @id @db.VarChar(120)
  value     Json
  updatedBy String? @db.Uuid
  updatedAt DateTime @updatedAt
  @@map("store_settings")
}

model TaxRule {
  id      String @id @default(uuid()) @db.Uuid
  country String @db.Char(2)
  region  String?
  name    String @db.VarChar(120)
  rate    Decimal @db.Decimal(5, 4)
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, region])
  @@map("tax_rules")
}

model ShippingZone {
  id      String @id @default(uuid()) @db.Uuid
  name    String @db.VarChar(120)
  countries String[]
  regions String[]
  methods ShippingMethod[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("shipping_zones")
}

model ShippingMethod {
  id          String @id @default(uuid()) @db.Uuid
  zoneId      String @db.Uuid
  name        String @db.VarChar(120)
  type        ShippingMethodType
  price       Decimal? @db.Decimal(12, 2)
  minWeightGrams Int?
  maxWeightGrams Int?
  minOrderAmount Decimal? @db.Decimal(12, 2)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  isActive    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("shipping_methods")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String @id @default(uuid()) @db.Uuid
  actorId   String? @db.Uuid
  action    String @db.VarChar(120)
  entityType String @db.VarChar(60)
  entityId  String? @db.VarChar(120)
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
