{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm ci && npx prisma generate && npm run build:web",
  "outputDirectory": "apps/storefront/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ecommerce-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://ecommerce-api.onrender.com/uploads/:path*" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/((?!admin(?:/|$)).*)", "destination": "/index.html" }
  ]
}
